{
  "name": "dsh-plugin-panel",
  "version": "0.1.13",
  "description": "Plugin manager for the DeepSeek Harness right sidebar: list installed plugins, see where each one lives, pin favourites, and open a plugin folder in Finder.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "bin",
    "index.js",
    "trend.js",
    "client.js",
    "catalog.js",
    "catalog.test.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/screenshot.jpg",
    "docs/screenshot-search.jpg",
    "docs/screenshot-trend.jpg",
    "docs/screenshot-daily.jpg",
    "icon.svg",
    "README.md",
    "templates"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "mobile": {
      "version": 1,
      "kind": "web",
      "title": "插件",
      "path": "/dsh-plugin-panel/mobile"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin-manager",
    "sidebar",
    "插件管理"
  ],
  "author": {
    "name": "jqlong17",
    "url": "https://github.com/jqlong17"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqlong17/dsh-plugin-panel.git"
  },
  "homepage": "https://github.com/jqlong17/dsh-plugin-panel#readme",
  "bugs": {
    "url": "https://github.com/jqlong17/dsh-plugins-ui/issues"
  },
  "bin": {
    "dsh-plugin-panel": "bin/check.js"
  }
}
